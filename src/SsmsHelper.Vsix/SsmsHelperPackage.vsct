      <Button guid="guidSsmsHelperCmdSet" id="cmdidRefreshSchema" priority="0x0090" type="Button">
        <Parent guid="guidSsmsHelperCmdSet" id="ToolsMenuGroup" />
        <Strings>
          <ButtonText>SSMS Helper: Refresh Schema</ButtonText>
