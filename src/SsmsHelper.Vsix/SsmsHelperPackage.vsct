        <Strings>
          <ButtonText>SSMS Helper: About</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <KeyBindings>
    <KeyBinding guid="guidSsmsHelperCmdSet" id="cmdidScriptObject" editor="guidVSStd97" key1="VK_F12" />
  </KeyBindings>

