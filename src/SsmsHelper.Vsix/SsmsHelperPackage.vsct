      <Button guid="guidSsmsHelperCmdSet" id="cmdidSurroundTransaction" priority="0x0088" type="Button">
        <Parent guid="guidSsmsHelperCmdSet" id="ToolsMenuGroup" />
        <Strings>
          <ButtonText>SSMS Helper: Surround with Transaction</ButtonText>
          <CanonicalName>.Tools.SSMSHelperSurroundWithTransaction</CanonicalName>
