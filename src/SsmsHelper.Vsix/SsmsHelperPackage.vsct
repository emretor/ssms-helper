  <Commands package="guidSsmsHelperPackage">
    <Groups>
      <Group guid="guidSsmsHelperCmdSet" id="ToolsMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
