<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidSsmsHelperPackage">
    <Menus>
      <Menu guid="guidSsmsHelperCmdSet" id="SsmsHelperSubMenu" priority="0x0100" type="Menu">
        <Parent guid="guidSsmsHelperCmdSet" id="ToolsMenuGroup" />
        <Strings>
          <ButtonText>SSMS Helper</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidSsmsHelperCmdSet" id="ToolsMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>

      <!-- Tools > SSMS Helper submenu (SSM-65): commands, then a separator and Options / About / Uninstall. -->
      <Group guid="guidSsmsHelperCmdSet" id="SubMenuCommandsGroup" priority="0x0100">
        <Parent guid="guidSsmsHelperCmdSet" id="SsmsHelperSubMenu" />
      </Group>
      <Group guid="guidSsmsHelperCmdSet" id="SubMenuInfoGroup" priority="0x0200">
        <Parent guid="guidSsmsHelperCmdSet" id="SsmsHelperSubMenu" />
      </Group>

      <!-- The SQL results grid's right-click menu: SQLEditors.dll shows menu 112 (IDM_SQLWB_SQLRESGRID_CONTEXT)
           under GUID_SQLEditorGroup, not under the command set GUID (CommonUtils.DisplayPopupMenu). -->
      <Group guid="guidSsmsHelperCmdSet" id="ResultsGridMenuGroup" priority="0x0700">
        <Parent guid="guidSqlEditorGroup" id="IDM_SQLWB_SQLRESGRID_CONTEXT" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidSsmsHelperCmdSet" id="cmdidSuggestJoin" priority="0x0080" type="Button">
        <Parent guid="guidSsmsHelperCmdSet" id="SubMenuCommandsGroup" />
        <Strings>
          <ButtonText>Suggest Join</ButtonText>
          <CanonicalName>.Tools.SSMSHelperSuggestJoin</CanonicalName>
          <LocCanonicalName>.Tools.SSMSHelperSuggestJoin</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidSsmsHelperCmdSet" id="cmdidScriptObject" priority="0x0085" type="Button">
        <Parent guid="guidSsmsHelperCmdSet" id="SubMenuCommandsGroup" />
        <Strings>
          <ButtonText>Script Object</ButtonText>
          <CanonicalName>.Tools.SSMSHelperScriptObject</CanonicalName>
          <LocCanonicalName>.Tools.SSMSHelperScriptObject</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidSsmsHelperCmdSet" id="cmdidSurroundTransaction" priority="0x0088" type="Button">
        <Parent guid="guidSsmsHelperCmdSet" id="SubMenuCommandsGroup" />
        <Strings>
          <ButtonText>Surround with Transaction</ButtonText>
          <CanonicalName>.Tools.SSMSHelperSurroundWithTransaction</CanonicalName>
          <LocCanonicalName>.Tools.SSMSHelperSurroundWithTransaction</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidSsmsHelperCmdSet" id="cmdidCopyAsInsert" priority="0x0010" type="Button">
        <Parent guid="guidSsmsHelperCmdSet" id="ResultsGridMenuGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Copy as INSERT</ButtonText>
          <CanonicalName>.Tools.SSMSHelperCopyAsInsert</CanonicalName>
          <LocCanonicalName>.Tools.SSMSHelperCopyAsInsert</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidSsmsHelperCmdSet" id="cmdidCopyAsInsertWithoutIdentity" priority="0x0020" type="Button">
        <Parent guid="guidSsmsHelperCmdSet" id="ResultsGridMenuGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Copy as INSERT (without identity)</ButtonText>
          <CanonicalName>.Tools.SSMSHelperCopyAsInsertWithoutIdentity</CanonicalName>
          <LocCanonicalName>.Tools.SSMSHelperCopyAsInsertWithoutIdentity</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidSsmsHelperCmdSet" id="cmdidRefreshSchema" priority="0x0090" type="Button">
        <Parent guid="guidSsmsHelperCmdSet" id="SubMenuCommandsGroup" />
        <Strings>
          <ButtonText>Refresh Schema</ButtonText>
          <CanonicalName>.Tools.SSMSHelperRefreshSchema</CanonicalName>
          <LocCanonicalName>.Tools.SSMSHelperRefreshSchema</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidSsmsHelperCmdSet" id="cmdidAbout" priority="0x0100" type="Button">
        <Parent guid="guidSsmsHelperCmdSet" id="SubMenuInfoGroup" />
        <Strings>
          <ButtonText>About</ButtonText>
          <CanonicalName>.Tools.SSMSHelperAbout</CanonicalName>
          <LocCanonicalName>.Tools.SSMSHelperAbout</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidSsmsHelperCmdSet" id="cmdidUninstall" priority="0x0110" type="Button">
        <Parent guid="guidSsmsHelperCmdSet" id="SubMenuInfoGroup" />
        <Strings>
          <ButtonText>Uninstall...</ButtonText>
          <CanonicalName>.Tools.SSMSHelperUninstall</CanonicalName>
          <LocCanonicalName>.Tools.SSMSHelperUninstall</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidSsmsHelperCmdSet" id="cmdidOptions" priority="0x0010" type="Button">
        <Parent guid="guidSsmsHelperCmdSet" id="SubMenuInfoGroup" />
        <Strings>
          <ButtonText>Options...</ButtonText>
          <CanonicalName>.Tools.SSMSHelperOptions</CanonicalName>
          <LocCanonicalName>.Tools.SSMSHelperOptions</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <KeyBindings>
    <KeyBinding guid="guidSsmsHelperCmdSet" id="cmdidScriptObject" editor="guidVSStd97" key1="VK_F12" />
    <KeyBinding guid="guidSsmsHelperCmdSet" id="cmdidSurroundTransaction" editor="guidVSStd97" key1="K" mod1="Control" key2="T" mod2="Control" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidSsmsHelperPackage" value="{4756aba8-bf31-468b-a64f-1fb39e6e36cc}" />
    <GuidSymbol name="guidSsmsHelperCmdSet" value="{ee6ca84e-96fa-481e-b475-d121aaccdeee}">
      <IDSymbol name="ToolsMenuGroup" value="0x1020" />
      <IDSymbol name="cmdidAbout" value="0x0100" />
      <IDSymbol name="cmdidRefreshSchema" value="0x0101" />
      <IDSymbol name="cmdidSuggestJoin" value="0x0102" />
      <IDSymbol name="cmdidScriptObject" value="0x0103" />
      <IDSymbol name="cmdidSurroundTransaction" value="0x0104" />
      <IDSymbol name="cmdidCopyAsInsert" value="0x0105" />
      <IDSymbol name="cmdidCopyAsInsertWithoutIdentity" value="0x0106" />
      <IDSymbol name="cmdidUninstall" value="0x0107" />
      <IDSymbol name="cmdidOptions" value="0x0108" />
      <IDSymbol name="SsmsHelperSubMenu" value="0x1040" />
      <IDSymbol name="SubMenuCommandsGroup" value="0x1050" />
      <IDSymbol name="SubMenuInfoGroup" value="0x1060" />
      <IDSymbol name="ResultsGridMenuGroup" value="0x1030" />
    </GuidSymbol>
    <GuidSymbol name="guidSqlEditorGroup" value="{33F13AC3-80BB-4ecb-85BC-225435603A5E}">
      <IDSymbol name="IDM_SQLWB_SQLRESGRID_CONTEXT" value="112" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
