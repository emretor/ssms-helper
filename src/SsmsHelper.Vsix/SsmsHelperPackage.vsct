    </Groups>

    <Buttons>
      <Button guid="guidSsmsHelperCmdSet" id="cmdidSuggestJoin" priority="0x0080" type="Button">
        <Parent guid="guidSsmsHelperCmdSet" id="ToolsMenuGroup" />
        <Strings>
          <ButtonText>SSMS Helper: Suggest Join</ButtonText>
          <CanonicalName>.Tools.SSMSHelperSuggestJoin</CanonicalName>
          <LocCanonicalName>.Tools.SSMSHelperSuggestJoin</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidSsmsHelperCmdSet" id="cmdidScriptObject" priority="0x0085" type="Button">
        <Parent guid="guidSsmsHelperCmdSet" id="ToolsMenuGroup" />
