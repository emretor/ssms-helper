<Project Sdk="Microsoft.NET.Sdk">
  <!-- In-process VSIX loaded by SSMS 22 (Visual Studio 2026 shell, .NET Framework 4.8 process).
       Keep this project thin: editor hooks, connection discovery, UI. Logic goes in SsmsHelper.Core. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>SsmsHelper</RootNamespace>
    <AssemblyName>SsmsHelper</AssemblyName>
    <UseWPF>true</UseWPF>
    <GenerateDependencyFile>false</GenerateDependencyFile>

    <!-- VSIX packaging. AutoSetup makes the VSSDK.BuildTools NuGet package import its packaging
         targets into this SDK-style project, so no "VS extension development" workload is needed. -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <CreateVsixContainer>true</CreateVsixContainer>
    <!-- DeployExtension targets the Visual Studio experimental hive, not SSMS. -->
    <DeployExtension>false</DeployExtension>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against the VS SDK only; SSMS supplies these assemblies at runtime. -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- .NET Framework assemblies that SDK-style projects do not reference by default. -->
    <Reference Include="System.Design" />
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SsmsHelper.Core\SsmsHelper.Core.csproj" />
  </ItemGroup>

  <!-- SSMS assemblies, referenced compile-only from a local SSMS 22 install so the host's copies are
       used at runtime. Override with -p:SsmsIdeDir=... when SSMS is installed elsewhere. -->
  <PropertyGroup>
    <SsmsIdeDir Condition="'$(SsmsIdeDir)' == ''">$(ProgramFiles)\Microsoft SQL Server Management Studio 22\Release\Common7\IDE</SsmsIdeDir>
    <!-- SSMS assemblies reference Visual Studio 18.x assemblies while the SDK package provides 17.14.
         SSMS's own binding redirects unify them at runtime, so the compile-time conflicts are noise. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <SsmsReference Include="SqlPackageBase" />
    <SsmsReference Include="SqlWorkbench.Interfaces" />
    <SsmsReference Include="ConnectionDlg" />
    <SsmsReference Include="Microsoft.SqlServer.RegSvrEnum" />
    <SsmsReference Include="Microsoft.SqlServer.ConnectionInfo" />
    <SsmsReference Include="Microsoft.Data.SqlClient" />
    <SsmsReference Include="Microsoft.SqlServer.Smo" />
    <SsmsReference Include="Microsoft.SqlServer.Management.Sdk.Sfc" />
    <Reference Include="@(SsmsReference)">
      <HintPath>$(SsmsIdeDir)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckSsmsInstall" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(SsmsIdeDir)\SqlWorkbench.Interfaces.dll')"
           Text="SSMS 22 assemblies not found in '$(SsmsIdeDir)'. Install SSMS 22 or pass -p:SsmsIdeDir=&lt;path to Common7\IDE&gt;." />
  </Target>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest" SubType="Designer" />
    <VSCTCompile Include="SsmsHelperPackage.vsct" ResourceName="Menus.ctmenu" />
  </ItemGroup>
</Project>
